NEXT_PUBLIC_SUPABASE_URL=https://bdqieraaueobnrjcxwtf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_DOPA_API_URL=http://localhost:8000
# Required in production. Use the canonical HTTPS origin without a trailing path.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Competitor intelligence database access (server-only)
# Use a Supabase secret key, never a publishable/browser key.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Alibaba MNS producer (server-only; SendMessage on one queue only)
ALIBABA_MNS_ACCOUNT_ID=
ALIBABA_MNS_REGION=us-east-1
ALIBABA_MNS_QUEUE=dopa-competitor-research-v1
ALIBABA_MNS_ACCESS_KEY_ID=
ALIBABA_MNS_ACCESS_KEY_SECRET=
# Optional explicit public endpoint.
ALIBABA_MNS_ENDPOINT=

# Shared only between Dopa's server routes and the ECS worker.
# Generate with: openssl rand -hex 32
DOPA_RESEARCH_HMAC_SECRET=

# Browser push (server-only except the public key returned by an authenticated API)
# Generate with: bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com

# Groq (server-only)
GROQ_API_KEY=your-groq-api-key

# FC Sandbox demo (server-only; leave FC_SANDBOX_PROVIDER=local until the
# AgentRun lifecycle gateway and evidence run are both ready)
FC_SANDBOX_PROVIDER=local
FC_DEMO_TOKEN_SECRET=generate-at-least-32-random-bytes
FC_DEMO_WEBHOOK_SECRET=generate-an-independent-32-byte-secret
CRON_SECRET=generate-an-independent-32-byte-secret
SUPABASE_SECRET_KEY=sb_secret_your-server-only-key

# Preferred live FC path. These are server-only and must never use a NEXT_PUBLIC_
# prefix. E2B_API_KEY is an Alibaba FC Sandbox key, not an E2B-hosted key.
E2B_API_KEY=your-expiring-fc-sandbox-api-key
E2B_API_URL=https://api.cn-hangzhou.e2b.fc.aliyuncs.com
E2B_DOMAIN=cn-hangzhou.e2b.fc.aliyuncs.com
AGENTRUN_TEMPLATE_NAME=code-interpreter-v1
# deep preserves the filesystem at lower cost; light also preserves processes.
AGENTRUN_HIBERNATION_MODE=deep
# Operator-only controlled failure drill. Keep `none` for the golden path.
FC_DEMO_FAILURE_MODE=none

# Optional private-gateway fallback when direct E2B-compatible lifecycle calls
# are not used.
AGENTRUN_LIFECYCLE_GATEWAY_URL=https://your-private-gateway.example.com
AGENTRUN_LIFECYCLE_GATEWAY_TOKEN=generate-an-independent-32-byte-token
AGENTRUN_EVIDENCE_SIGNING_SECRET=generate-an-independent-32-byte-secret
AGENTRUN_ACCOUNT_ID=your-alibaba-cloud-account-id

# Server-side TRIBE v2 scoring. Use a dedicated Supabase Auth identity with no
# app-data memberships; the server signs in just-in-time for a short-lived JWT.
# The Supabase URL/key default to the matching NEXT_PUBLIC_ values above.
DOPA_API_INTERNAL_URL=https://your-private-tribe-api.example.com
DOPA_DEMO_SUPABASE_URL=https://bdqieraaueobnrjcxwtf.supabase.co
DOPA_DEMO_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
DOPA_DEMO_USER_EMAIL=fc-demo@your-domain.example
DOPA_DEMO_USER_PASSWORD=generate-at-least-32-random-bytes
# Optional short-lived compatibility fallback. Prefer the renewable identity.
DOPA_API_INTERNAL_TOKEN=
# Optional override; defaults to NEXT_PUBLIC_SITE_URL plus this asset path.
DOPA_DEMO_CREATIVE_URL=https://your-site.example/demo/dopa-proof-creative.mp4

# Alibaba SLS (server-only). Structured FC telemetry is shipped when all five
# values are set; otherwise emitFcTelemetry still writes console JSON only.
ALIYUN_SLS_ENDPOINT=cn-hangzhou.log.aliyuncs.com
ALIYUN_SLS_PROJECT=dopa-fc-sandbox
ALIYUN_SLS_LOGSTORE=fc-telemetry
ALIYUN_SLS_ACCESS_KEY_ID=
ALIYUN_SLS_ACCESS_KEY_SECRET=

# Optional HTTPS webhook for FC alert dispatch (DingTalk / Slack / custom).
# When unset, alerts still emit structured console telemetry only.
FC_ALERT_WEBHOOK_URL=

# Evidence harness only. The elasticity probe is skipped unless `--stress` is
# supplied and all three charge-authorization values are valid.
FC_HIBERNATION_PROOF_MS=60000
FC_ELASTICITY_TARGET=100000
FC_STRESS_ACK=
FC_STRESS_MAX_SPEND_CNY=
# Optional. This defaults to Groq's production GPT-OSS 120B model.
GROQ_DENVER_MODEL=openai/gpt-oss-120b
# Optional semantic prompt-injection classifier used before Denver answers.
GROQ_DENVER_GUARD_MODEL=openai/gpt-oss-safeguard-20b

# Google Ads API (server-only)
GOOGLE_ADS_CUSTOMER_ID=1234567890
GOOGLE_ADS_DEVELOPER_TOKEN=your-google-ads-developer-token
# Required only when accessing a client through a manager account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Use the same Google OAuth client configured for the Supabase Google provider.
GOOGLE_ADS_OAUTH_CLIENT_ID=
GOOGLE_ADS_OAUTH_CLIENT_SECRET=
# Generate with: openssl rand -base64 32
GOOGLE_ADS_TOKEN_ENCRYPTION_KEY=
