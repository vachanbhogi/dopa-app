NEXT_PUBLIC_SUPABASE_URL=https://bdqieraaueobnrjcxwtf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_DOPA_API_URL=http://localhost:8000

# Groq (server-only)
GROQ_API_KEY=your-groq-api-key
# Optional. This defaults to Groq's production GPT-OSS 120B model.
GROQ_DENVER_MODEL=openai/gpt-oss-120b
# Optional semantic prompt-injection classifier used before Denver answers.
GROQ_DENVER_GUARD_MODEL=openai/gpt-oss-safeguard-20b

# Google Ads API (server-only)
GOOGLE_ADS_CUSTOMER_ID=1234567890
GOOGLE_ADS_DEVELOPER_TOKEN=your-google-ads-developer-token
# Required only when accessing a client through a manager account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Use the same Google OAuth client configured for the Supabase Google provider.
GOOGLE_ADS_OAUTH_CLIENT_ID=
GOOGLE_ADS_OAUTH_CLIENT_SECRET=
# Generate with: openssl rand -base64 32
GOOGLE_ADS_TOKEN_ENCRYPTION_KEY=
